generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Ingredient {
  id              Int    @id @default(autoincrement())
  name            String
  characteristics String
}
model Review {
  id         Int      @id @default(autoincrement())
  recipeName String
  reviewer   String
  rating     Int
  comment    String
  createdAt  DateTime @default(now())
}